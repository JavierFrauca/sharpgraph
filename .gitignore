docs/Comparativa_MCP_*

# Logs sueltos de desarrollo
scan_output.txt
test_nopath.txt

# ZCode CLI (archivos locales del agente, no del proyecto)
.zcode/
.simplecode/

# Extensión VS Code (artefactos de build)
